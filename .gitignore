# Learn more: https://docs.github.com/en/get-started/git-basics/ignoring-files

# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Local environment files and secrets
.env
.env.*
!.env.example
!.env.template

# Native projects generated by Expo Prebuild
# Remove these two rules if you decide to commit ios/ or android/ later.
/ios/
/android/

# Native build credentials and signing files
*.jks
*.keystore
*.p8
*.p12
*.pfx
*.key
*.pem
*.mobileprovision

# Kotlin and generated files
.kotlin/
*.orig.*
*.tsbuildinfo

# Metro
.metro-health-check*

# Logs and test output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
coverage/

# macOS and Windows
.DS_Store
._*
Thumbs.db

# Project-specific generated/example folder
example/
